# Atlas v4 Configuration
# Copy to .env and fill in values

# Server
ATLAS_PORT=8000
ATLAS_HOST=127.0.0.1
ATLAS_LOG_LEVEL=INFO

# LLM Providers (at least one required for full functionality)
ATLAS_DEFAULT_LLM_PROVIDER=stub  # Options: openai, anthropic, stub
ATLAS_OPENAI_API_KEY=
ATLAS_ANTHROPIC_API_KEY=

# Feature Flags
ATLAS_ENABLE_VOICE=false
ATLAS_ENABLE_LEARNING=true
ATLAS_ENABLE_SELF_MODIFY=false
