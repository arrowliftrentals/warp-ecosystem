#!/usr/bin/env bash
# Pre-commit hook: enforces doc standard, protected file guard, and code quality.
# No bypass. Fix the violations.

FAILED=0

# =============================================================================
# 1. Protected file guard — these files are frozen during distillation/coding.
#    Only modify through a deliberate infrastructure commit.
# =============================================================================

PROTECTED_FILES=(
    "design-bible/00-system-principles.md"
    "design-bible/gate-output/shared-contracts.md"
    "design-bible/gate-output/conflict-report.md"
    "design-bible/gate-output/build-order-refined.md"
    "design-bible/gate-output/mva-refined.md"
    "design-bible/gate-output/quality-flags.md"
    "design-bible/PROJECT_CONVENTIONS.md"
    "design-bible/DISTILLATION_PROTOCOL.md"
    "design-bible/CODING_PROTOCOL.md"
    "design-bible/VOLUME_TEMPLATE.md"
)

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)

for pf in "${PROTECTED_FILES[@]}"; do
    if echo "$STAGED_ALL" | grep -qx "$pf"; then
        echo "PROTECTED: $pf is frozen. Do not modify during distillation/coding."
        FAILED=1
    fi
done

if [[ $FAILED -ne 0 ]]; then
    echo ""
    echo "Commit blocked — protected files modified."
    echo "If this is a deliberate infrastructure change, temporarily move the file"
    echo "out of the protected list in scripts/hooks/pre-commit, commit, then restore."
    exit 1
fi

# =============================================================================
# 2. Doc standard linter — all .md files in design-bible/ and atlas-v4/ must comply.
# =============================================================================

STAGED_DOCS=$(echo "$STAGED_ALL" | grep -E '^(design-bible|atlas-v4)/.*\.md$' || true)

if [[ -n "$STAGED_DOCS" ]]; then
    for f in $STAGED_DOCS; do
        if ! bash scripts/lint-docs.sh "$f" > /dev/null 2>&1; then
            FAILED=1
            bash scripts/lint-docs.sh "$f"
        fi
    done

    if [[ $FAILED -ne 0 ]]; then
        echo ""
        echo "Commit blocked — fix doc standard violations above."
        exit 1
    fi
fi

# =============================================================================
# 3. Python code quality — ruff + mypy + no TODOs (active when .py files staged)
# =============================================================================

STAGED_PY=$(echo "$STAGED_ALL" | grep '^atlas-v4/.*\.py$' || true)

if [[ -n "$STAGED_PY" ]]; then
    # ruff
    if command -v python3 &>/dev/null && python3 -m ruff check --quiet $STAGED_PY; then
        : # pass
    else
        echo ""
        echo "ruff check failed on staged .py files."
        FAILED=1
    fi

    # mypy
    if command -v python3 &>/dev/null && python3 -m mypy --strict $STAGED_PY 2>/dev/null; then
        : # pass
    else
        echo ""
        echo "mypy --strict failed on staged .py files."
        FAILED=1
    fi

    # No TODOs in production code
    STAGED_SRC_PY=$(echo "$STAGED_PY" | grep '^atlas-v4/src/' || true)
    if [[ -n "$STAGED_SRC_PY" ]]; then
        TODO_HITS=$(grep -rn 'TODO' $STAGED_SRC_PY 2>/dev/null || true)
        if [[ -n "$TODO_HITS" ]]; then
            echo ""
            echo "TODO comments found in production code (create issues instead):"
            echo "$TODO_HITS"
            FAILED=1
        fi
    fi

    if [[ $FAILED -ne 0 ]]; then
        echo ""
        echo "Commit blocked — fix code quality issues above."
        exit 1
    fi
fi
